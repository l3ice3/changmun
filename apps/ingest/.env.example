# 이 파일을 .env로 복사하고 값을 채운다. .env는 절대 커밋하지 않는다 (.gitignore 처리됨).

# K-Startup (data.go.kr) — "일반 인증키(Decoding)" 값을 넣는다 (인코딩된 키 아님)
KSTARTUP_API_KEY=

# 기업마당 crtfcKey — 발급 후 기입 (FR-001 후속)
BIZINFO_API_KEY=

# 온통청년 apiKeyNm — 발급 후 기입 (FR-001 후속, 배포 주소 필요)
ONTONG_API_KEY=

# 로컬 docker compose 기본값과 동일하면 생략 가능
DATABASE_URL=postgresql://changmun:changmun@localhost:5432/changmun
