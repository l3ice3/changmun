// =====================================================================
// build.gradle 에 추가할 설정 (관련 부분만 발췌)
// 기존 build.gradle 의 plugins / dependencies / 하단에 병합한다.
// =====================================================================

plugins {
    id 'java'
    id 'checkstyle'
    id 'pmd'
}

// ---------- Checkstyle (A그룹: 스타일/라인/분기 자동 차단) ----------
checkstyle {
    toolVersion = '10.20.1'
    configFile = file("${rootDir}/config/checkstyle.xml")
    // 위반이 있으면 빌드 실패 → PR 반려
    maxWarnings = 0
    maxErrors = 0
    ignoreFailures = false
}

// ---------- PMD (A그룹: 필드수/디미터 등) ----------
pmd {
    toolVersion = '7.7.0'
    ruleSetFiles = files("${rootDir}/config/pmd-ruleset.xml")
    ruleSets = []          // 기본 룰셋 비활성, 커스텀만 사용
    ignoreFailures = false // 위반 시 빌드 실패
}

dependencies {
    // ---------- ArchUnit (계층 규칙 자동 검사) ----------
    testImplementation 'com.tngtech.archunit:archunit-junit5:1.3.0'

    // (참고) 테스트 기본 의존
    testImplementation 'org.junit.jupiter:junit-jupiter:5.11.3'
}

test {
    useJUnitPlatform()
}

// checkstyle/pmd 가 check 태스크에 묶여 있어
// `./gradlew check` 또는 `./gradlew build` 시 함께 실행된다.
