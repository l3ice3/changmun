<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  A그룹(자동 차단) 규칙. 셀 수 있는 것만 담는다.
  severity=error 인 항목은 위반 시 빌드 실패 → PR 반려.
  근거: AGENTS.md §2 리뷰 분담 A그룹
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>

    <!-- 파일 단위 검사 -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^\s*//"/>
    </module>

    <module name="TreeWalker">

        <!-- indent depth ≤ 2 (중첩 블록 깊이 제한). 메서드 본문 기준 2단계까지 -->
        <module name="NestedIfDepth">
            <property name="max" value="1"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="1"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="1"/>
        </module>

        <!-- 메서드 ≤ 20라인 -->
        <module name="MethodLength">
            <property name="tokens" value="METHOD_DEF"/>
            <property name="max" value="20"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- 메서드 인자 ≤ 4 -->
        <module name="ParameterNumber">
            <property name="max" value="4"/>
            <property name="tokens" value="METHOD_DEF,CTOR_DEF"/>
        </module>

        <!-- else 금지 -->
        <module name="IllegalToken">
            <property name="tokens" value="LITERAL_ELSE"/>
            <message key="illegal.token" value="else 사용 금지. early return으로 평탄화하라."/>
        </module>

        <!-- switch / case 금지 -->
        <module name="IllegalToken">
            <property name="tokens" value="LITERAL_SWITCH"/>
            <message key="illegal.token" value="switch 사용 금지. 타입 분기는 다형성으로 전환하라."/>
        </module>

        <!-- 삼항 연산자 금지 -->
        <module name="IllegalToken">
            <property name="tokens" value="QUESTION"/>
            <message key="illegal.token" value="삼항 연산자 사용 금지."/>
        </module>

        <!-- 네이밍: 한 글자/축약 방지 (최소 2글자, 관례적 i,j 루프 변수는 별도 허용 안 함) -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{1,}$"/>
            <message key="name.invalidPattern" value="축약/한글자 변수명 금지. 의도를 드러내라."/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{1,}$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
        </module>
        <module name="TypeName"/>

        <!-- 배열 멤버 선언 경고 (컬렉션 권장). 완전 차단은 과해서 warning -->
        <module name="ArrayTypeStyle"/>

    </module>
</module>
