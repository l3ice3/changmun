# EC2 배포 시크릿 템플릿 — 이 파일을 .env로 복사해 값 채운다. .env는 커밋 금지(.gitignore).
#   cp .env.example .env

# api 이미지 태그 (선택) — 평소엔 비워두면 latest. 롤백 시에만 되돌릴 커밋 sha 지정.
#   예: API_IMAGE_TAG=1a2b3c4  → docker compose pull api && up -d api
# API_IMAGE_TAG=

# DB (EC2 내부 Postgres 컨테이너)
POSTGRES_DB=changmun
POSTGRES_USER=changmun
POSTGRES_PASSWORD=            # ← 강한 비밀번호로. 로컬의 changmun 재사용 금지

# 프론트 오리진 (web = Vercel 도메인)
CHANGMUN_ALLOWED_ORIGINS=https://www.changmun.com
CHANGMUN_FRONTEND_URL=https://www.changmun.com

# OAuth — 각 provider 콘솔에서 발급받은 실제 값. 리다이렉트 URI는 https://api.changmun.com/login/oauth2/code/{provider}
# ⚠️ 아래 8개는 하나라도 비우면 api 기동 실패(Spring이 빈 client-id 거부). 4개 provider 값 모두 채울 것.
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_KAKAO_ID=
OAUTH_KAKAO_SECRET=
OAUTH_NAVER_ID=
OAUTH_NAVER_SECRET=
